# Admin login password (plain string compared server-side)
CMS_ADMIN_PASSWORD=replace-with-a-long-random-password

# Secret used to sign the HttpOnly session cookie
CMS_SESSION_SECRET=replace-with-another-long-random-secret

# GitHub Contents API credentials (server-side only)
GITHUB_TOKEN=github_pat_or_classic_token_with_repo_contents_write
GITHUB_OWNER=inesia
GITHUB_REPO=ttslawyers-alt
GITHUB_BRANCH=main
